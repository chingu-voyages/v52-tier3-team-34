{
  "name": "your-app-name",
  "version": "1.0.0",
  "engines": {
    "node": ">=14.0.0"
  },
  "description": "This is the backend application built with Node.js, Express, TypeScript, Prisma, SQLite/PostgreSQL, and Zod.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc && prisma generate",
    "start": "node dist/src/server.js",
    "test": "set NODE_ENV=development && jest",
    "test:dev": "set NODE_ENV=development && jest",
    "test:staging": "set NODE_ENV=staging && jest",
    "test:prod": "set NODE_ENV=production && jest",
    "test:api": "set NODE_ENV=development && jest tests/api",
    "test:unit": "set NODE_ENV=development && jest tests/unit",
    "test:integration": "set NODE_ENV=development && jest tests/integration"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "axios": "^1.6.7",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "google-auth-library": "^9.15.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
