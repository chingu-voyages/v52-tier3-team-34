{
	"info": {
		"name": "Auth Spike API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "0. Google OAuth Setup",
			"item": [
				{
					"name": "Get Google Token",
					"request": {
						"auth": {
							"type": "oauth2",
							"oauth2": {
								"accessTokenUrl": "https://oauth2.googleapis.com/token",
								"authUrl": "https://accounts.google.com/o/oauth2/v2/auth",
								"clientId": "{{GOOGLE_CLIENT_ID}}",
								"clientSecret": "{{GOOGLE_CLIENT_SECRET}}",
								"grant_type": "authorization_code",
								"redirect_uri": "https://oauth.pstmn.io/v1/callback",
								"scope": "email profile openid",
								"state": "random_state_string",
								"challengeAlgorithm": "S256",
								"useBrowser": true,
								"addTokenTo": "header"
							}
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{BASE_URL}}/api/v1/health",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "v1", "health"]
						},
						"description": "Use this request's Authorization tab to get a new Google token. Click 'Get New Access Token' to start the flow."
					}
				}
			]
		},
		{
			"name": "1. Health Checks",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{BASE_URL}}/api/v1/health",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "v1", "health"]
						}
					}
				},
				{
					"name": "Protected Health Check",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{JWT}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{BASE_URL}}/api/v1/health/auth",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "v1", "health", "auth"]
						}
					}
				}
			]
		},
		{
			"name": "2. Authentication Flow",
			"item": [
				{
					"name": "Login with Google",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = JSON.parse(responseBody);",
									"if (jsonData.token) {",
									"    pm.environment.set(\"JWT\", jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"googleIdToken\": \"{{GOOGLE_ID_TOKEN}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{BASE_URL}}/api/v1/auth/login",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "v1", "auth", "login"]
						}
					}
				},
				{
					"name": "Get Profile",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{JWT}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{BASE_URL}}/api/v1/auth/profile",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "v1", "auth", "profile"]
						}
					}
				},
				{
					"name": "Logout",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{JWT}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{BASE_URL}}/api/v1/auth/logout",
							"host": ["{{BASE_URL}}"],
							"path": ["api", "v1", "auth", "logout"]
						}
					}
				}
			]
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [""]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [""]
			}
		}
	],
	"variable": []
}
