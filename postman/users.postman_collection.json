{
  "info": {
    "name": "Users API",
    "description": "User management endpoints including authentication, profile management, and user events",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "List Users - Basic",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/users",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "users"]
        },
        "description": "Get a list of users with default pagination"
      }
    },
    {
      "name": "Create User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@example.com\",\n  \"name\": \"John Doe\",\n  \"picture\": \"https://example.com/photo.jpg\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/users",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "users"]
        },
        "description": "Create a new user"
      }
    },
    {
      "name": "Update User - Full Update",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"updated@example.com\",\n  \"name\": \"Updated Name\",\n  \"picture\": \"https://example.com/updated.jpg\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/users/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "users", "1"]
        },
        "description": "Update all user fields"
      }
    },
    {
      "name": "Update User - Partial Update",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Updated Name\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/users/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "users", "1"]
        },
        "description": "Update specific user fields"
      }
    },
    {
      "name": "Get User Events - Basic",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/users/1/events",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "users", "1", "events"]
        },
        "description": "Retrieve all events for a specific user with default pagination (10 items per page)"
      }
    },
    {
      "name": "Get User Events - Filtered",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/users/1/events?filter[startDate]=2024-11-30&filter[endDate]=2024-12-02&filter[status]=published&sort=startDate:asc",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "users", "1", "events"],
          "query": [
            {
              "key": "filter[startDate]",
              "value": "2024-11-30"
            },
            {
              "key": "filter[endDate]",
              "value": "2024-12-02"
            },
            {
              "key": "filter[status]",
              "value": "published"
            },
            {
              "key": "sort",
              "value": "startDate:asc"
            }
          ]
        },
        "description": "Retrieve filtered events for a specific user:\n- Date range filter\n- Status filter\n- Sorted by start date ascending"
      }
    },
    {
      "name": "Get User Events - Paginated",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/users/1/events?page=2&limit=5",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "users", "1", "events"],
          "query": [
            {
              "key": "page",
              "value": "2"
            },
            {
              "key": "limit",
              "value": "5"
            }
          ]
        },
        "description": "Retrieve paginated events for a specific user:\n- Page 2\n- 5 items per page"
      }
    }
  ]
}
