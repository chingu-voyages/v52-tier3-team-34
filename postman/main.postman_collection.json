  },
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "API Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Basic health check endpoint to verify API availability"
          }
        },
        {
          "name": "Auth Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{JWT}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health/auth",
              "host": ["{{baseUrl}}"],
              "path": ["health", "auth"]
            },
            "description": "Authenticated health check to verify JWT functionality"
          }
        }
      ]
    },
