				{
					"name": "Filter Venues by Amenities",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/venues/search?amenities=Full Bar,VIP Seating",
							"host": ["{{baseUrl}}"],
							"path": ["venues", "search"],
							"query": [
								{
									"key": "amenities",
									"value": "Full Bar,VIP Seating"
								}
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Error Scenarios",
			"item": [
				{
					"name": "Get Invalid Venue ID",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 404\", function () {",
									"    pm.response.to.have.status(404);",
									"});",
									"",
									"pm.test(\"Error message is correct\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.message).to.eql(\"Venue not found\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/venues/invalid_id",
							"host": ["{{baseUrl}}"],
							"path": ["venues", "invalid_id"]
						}
					},
					"response": []
				},
				{
					"name": "Create Venue - Missing Required Fields",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 400\", function () {",
									"    pm.response.to.have.status(400);",
									"});",
									"",
									"pm.test(\"Validation error message is present\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.message).to.include(\"validation failed\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"description\": \"Missing required fields\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/venues",
							"host": ["{{baseUrl}}"],
							"path": ["venues"]
						}
					},
					"response": []
				},
				{
					"name": "Create Venue - Invalid Location Format",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 400\", function () {",
									"    pm.response.to.have.status(400);",
									"});",
									"",
									"pm.test(\"Location validation error is present\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.message).to.include(\"location\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Invalid Location Venue\",\n    \"location\": {\n        \"type\": \"Invalid\",\n        \"coordinates\": [\"not\", \"valid\"]\n    }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/venues",
							"host": ["{{baseUrl}}"],
							"path": ["venues"]
						}
					},
					"response": []
				},
				{
					"name": "Invalid Geospatial Query",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 400\", function () {",
									"    pm.response.to.have.status(400);",
									"});",
									"",
									"pm.test(\"Validation error for coordinates\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.message).to.include(\"coordinates\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/venues/near?lat=invalid&lng=invalid",
							"host": ["{{baseUrl}}"],
							"path": ["venues", "near"],
							"query": [
								{
									"key": "lat",
									"value": "invalid"
								},
								{
									"key": "lng",
									"value": "invalid"
								}
							]
						}
					},
					"response": []
				}
			]
		}
