		"name": "Venues API",
		"description": "Collection for testing the Venues API endpoints including basic operations, geospatial queries, and error scenarios",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Basic Operations",
			"item": [
				{
					"name": "Get All Venues",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/venues",
							"host": ["{{baseUrl}}"],
							"path": ["venues"]
						}
					},
					"response": []
				},
				{
					"name": "Get Venue by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/venues/{{venueId}}",
							"host": ["{{baseUrl}}"],
							"path": ["venues", "{{venueId}}"],
							"variable": [
								{
									"key": "venueId",
									"value": "65c3a2f156e4c5920f1811df"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Create Venue",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Blue Note Jazz Club\",\n    \"description\": \"Iconic jazz venue featuring world-class musicians\",\n    \"address\": {\n        \"street\": \"131 W 3rd St\",\n        \"city\": \"New York\",\n        \"state\": \"NY\",\n        \"zipCode\": \"10012\",\n        \"country\": \"USA\"\n    },\n    \"location\": {\n        \"type\": \"Point\",\n        \"coordinates\": [-74.0014, 40.7308]\n    },\n    \"capacity\": 200,\n    \"amenities\": [\"Full Bar\", \"Restaurant\", \"VIP Seating\"],\n    \"contact\": {\n        \"phone\": \"+1-212-475-8592\",\n        \"email\": \"info@bluenote.net\",\n        \"website\": \"www.bluenotejazz.com\"\n    }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/venues",
							"host": ["{{baseUrl}}"],
							"path": ["venues"]
						}
					},
					"response": []
				},
				{
					"name": "Update Venue",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Updated Blue Note Jazz Club\",\n    \"capacity\": 250,\n    \"amenities\": [\"Full Bar\", \"Restaurant\", \"VIP Seating\", \"Private Events\"]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/venues/{{venueId}}",
							"host": ["{{baseUrl}}"],
							"path": ["venues", "{{venueId}}"],
							"variable": [
								{
									"key": "venueId",
									"value": "65c3a2f156e4c5920f1811df"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Delete Venue",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/venues/{{venueId}}",
							"host": ["{{baseUrl}}"],
							"path": ["venues", "{{venueId}}"],
							"variable": [
								{
									"key": "venueId",
									"value": "65c3a2f156e4c5920f1811df"
								}
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Geospatial Operations",
			"item": [
				{
					"name": "Find Venues Near Location",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/venues/near?lat=40.7128&lng=-74.0060&maxDistance=10000",
							"host": ["{{baseUrl}}"],
							"path": ["venues", "near"],
							"query": [
								{
									"key": "lat",
									"value": "40.7128"
								},
								{
									"key": "lng",
									"value": "-74.0060"
								},
								{
									"key": "maxDistance",
									"value": "10000"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Find Venues in Radius (Times Square)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/venues/near?lat=40.7580&lng=-73.9855&maxDistance=5000",
							"host": ["{{baseUrl}}"],
							"path": ["venues", "near"],
							"query": [
								{
									"key": "lat",
									"value": "40.7580"
								},
								{
									"key": "lng",
									"value": "-73.9855"
								},
								{
									"key": "maxDistance",
									"value": "5000"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Find Venues by City",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/venues/search?city=New York",
							"host": ["{{baseUrl}}"],
							"path": ["venues", "search"],
							"query": [
								{
									"key": "city",
									"value": "New York"
								}
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Advanced Queries",
			"item": [
				{
					"name": "Search Venues by Capacity",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/venues/search?minCapacity=200&maxCapacity=1000",
							"host": ["{{baseUrl}}"],
							"path": ["venues", "search"],
							"query": [
								{
									"key": "minCapacity",
									"value": "200"
