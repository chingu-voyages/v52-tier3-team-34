{
  "info": {
    "name": "Events API",
    "description": "Event management endpoints including creation, updates, and advanced filtering",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "List Events - Basic",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/events",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "events"]
        },
        "description": "Get a list of events with default pagination"
      }
    },
    {
      "name": "Create Event",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Music Festival\",\n  \"description\": \"Annual music festival\",\n  \"startDate\": \"2024-07-01T18:00:00Z\",\n  \"endDate\": \"2024-07-01T23:00:00Z\",\n  \"status\": \"published\",\n  \"artist\": \"Various Artists\",\n  \"genre\": [\"Rock\", \"Pop\"],\n  \"price\": 50,\n  \"venueId\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/events",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "events"]
        },
        "description": "Create a new event"
      }
    },
    {
      "name": "Update Event - Full Update",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated Festival\",\n  \"description\": \"Updated description\",\n  \"startDate\": \"2024-07-02T18:00:00Z\",\n  \"endDate\": \"2024-07-02T23:00:00Z\",\n  \"status\": \"published\",\n  \"artist\": \"New Artists\",\n  \"genre\": [\"Jazz\", \"Blues\"],\n  \"price\": 60,\n  \"venueId\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/events/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "events", "1"]
        },
        "description": "Update all event fields"
      }
    },
    {
      "name": "Update Event - Partial Update",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated Title\",\n  \"price\": 55\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/events/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "events", "1"]
        },
        "description": "Update specific event fields"
      }
    },
    {
      "name": "Get Events in Zone",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/events/zone?lat=40.7128&lng=-74.0060&radius=5",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "events", "zone"],
          "query": [
            {
              "key": "lat",
              "value": "40.7128"
            },
            {
              "key": "lng",
              "value": "-74.0060"
            },
            {
              "key": "radius",
              "value": "5"
            }
          ]
        },
        "description": "Get events at venues within a specific radius of coordinates"
      }
    }
  ]
}
